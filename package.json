{
  "name": "kartesian",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "node scripts/build/prepare-next.cjs && next dev --webpack",
    "start": "node scripts/build/serve-next.cjs",
    "docker:build": "docker build -t kartesian .",
    "docker:run": "docker run --rm -p 8080:8080 kartesian",
    "build": "node scripts/build/prepare-next.cjs && next build --webpack && node scripts/build/build-offline.cjs",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:src": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx,js,cjs}\" \"scripts/**/*.cjs\"",
    "benchmark": "node scripts/tools/benchmark-next.cjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:signing && pnpm run build && pnpm run test:e2e && pnpm run test:detector",
    "test:signing": "node --test tests/signing/signing-config.test.cjs",
    "test:detector": "python -m unittest discover -s services/pdf-field-detector -p test_*.py",
    "detector:install": "python scripts/tools/install-detector.py",
    "detector:install:ocr": "python scripts/tools/install-detector.py --ocr",
    "detector:start": "python services/pdf-field-detector/server.py",
    "record:showcase": "node scripts/tools/record-showcase.cjs",
    "generate:showcase": "node scripts/tools/generate-showcase.cjs",
    "capture:landing": "node scripts/tools/capture-landing.cjs",
    "audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ace-builds": "1.16.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "29.1.1",
    "lucide": "0.460.0",
    "pdfjs-dist": "6.2.108",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "driver.js": "1.14.0",
    "lucide-react": "1.61.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "1.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
